vim9script

# fat cursor - cursor blink win32console and gui only
# set guicursor=a:block-blinkon0

#hl-TitleBar
# set guioptions+=C
set guioptions+=d #win32 titlebar is better?

if has("win32")
	if has("directx")
		# https://neovide.dev/configuration.html
		# set renderoptions=type:directx,gamma:2.2,contrast:0.5
		# some colors doesnt look good with this
	endif
	set linespace=0
endif

# seee :h gui-w32-fullscreen
map <expr> <F11> &go =~# 's' ? ":se go-=s<CR>" : ":se go+=s<CR>"
